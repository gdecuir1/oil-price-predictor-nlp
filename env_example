# Copy to ".env" in this directory (see .gitignore). Required for scraper_engine.py:
#   CAPTCHA_API_KEY — CapSolver (https://www.capsolver.com/) for ReCaptchaV2 when Google blocks.
#   GOLOGIN_API_TOKEN — GoLogin (https://app.gologin.com/) to launch the anti-detect browser profile.
#   DEFAULT_PROXY — optional HTTP smart/residential proxy for scripts that route traffic through a gateway.

# CapSolver client key
CAPTCHA_API_KEY=YOUR_CAPSOLVER_CLIENT_KEY

# Smart proxy (example: Decodo unblock gateway). Format: http://USERNAME:PASSWORD@HOST:PORT
DEFAULT_PROXY=http://YOUR_SMART_PROXY_USERNAME:YOUR_SMART_PROXY_PASSWORD@unblock.decodo.com:60000

# GoLogin API token
GOLOGIN_API_TOKEN=YOUR_GOLOGIN_API_TOKEN
