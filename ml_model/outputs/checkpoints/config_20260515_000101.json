{
  "window_days": 5,
  "gap_days": 0,
  "horizon_days": 1,
  "label_mode": "binary",
  "flat_band_pct": 0.35,
  "price_ticker": "USO",
  "price_start": "2025-04-28",
  "price_end": "2026-05-13",
  "embedding_model": "ProsusAI/finbert",
  "finbert_dim": 768,
  "use_keywords": true,
  "max_articles_per_day": 20,
  "max_tokens_per_article": 256,
  "article_pooling": "cls",
  "proj_dim": 256,
  "lstm_hidden": 128,
  "lstm_layers": 2,
  "mlp_hidden": 64,
  "dropout": 0.3,
  "bidirectional": true,
  "use_residual": true,
  "train_val_test_split": [
    0.8,
    0.1,
    0.1
  ],
  "batch_size": 16,
  "epochs": 50,
  "lr": 0.0002,
  "weight_decay": 0.0001,
  "patience": 8,
  "use_class_weights": true,
  "use_weighted_sampler": true,
  "label_smoothing": 0.05,
  "max_grad_norm": 1.0,
  "normalize_features": true,
  "early_stopping_metric": "val_loss",
  "checkpoint_dir": "ml_model/outputs/checkpoints",
  "report_dir": "ml_model/outputs/reports",
  "embed_cache_path": "ml_model/outputs/embed_cache_v3.pt",
  "price_cache_path": "ml_model/outputs/price_cache.csv",
  "raw_articles_dir": "raw_articles",
  "parsed_articles_dir": "parsed_articles"
}