  "weight_decay": 0.0001,
  "patience": 6,
  "use_class_weights": true,
  "checkpoint_dir": "ml_model/outputs/checkpoints",
  "report_dir": "ml_model/outputs/reports",
  "embed_cache_path": "ml_model/outputs/embed_cache.pt",
